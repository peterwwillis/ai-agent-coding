# Caddyfile – local reverse-proxy for AI services
# =============================================================================
# Hostname: adapt the site address below to match your machine's LAN hostname
# or IP.  Examples:
#   myhost.local       – custom mDNS / Avahi hostname on Linux
#   192.168.1.50       – static LAN IP (no hostname resolution needed)
#
# TLS: cert/key files are mounted at /etc/caddy/certs/ (see docker-compose.yml).
#      Update the tls directive if you rename the files.
#
# Host reachability (upstream services on the Docker host):
#   macOS / Docker Desktop: host.docker.internal  (set automatically)
#   Linux: replace host.docker.internal below with your host's LAN IP,
#          e.g. 192.168.1.50, or add extra_hosts to docker-compose.yml:
#            extra_hosts:
#              - "host.docker.internal:host-gateway"
#
# Basic-auth credentials:
#   Set PROXY_AUTH_USER and PROXY_AUTH_HASH in .env (see .env.example).
#   Caddy substitutes {env.VAR} placeholders at startup – no secrets in this file.
#   Generate a hash with: make gen-hash
#
#   To load from an external secrets manager, export vars before starting:
#     export PROXY_AUTH_USER=admin
#     export PROXY_AUTH_HASH="$(vault kv get -field=hash secret/proxy)"
#     make up
# =============================================================================

# Change localhost to your machine's hostname or IP.
# You can also use {env.PROXY_DOMAIN} here if set in .env.
{$PROXY_DOMAIN:localhost} {

    # --------------------------------------------------------------------------
    # Local TLS – serve the self-signed / CA-signed certificate
    # --------------------------------------------------------------------------
    tls /etc/caddy/certs/local.crt /etc/caddy/certs/local.key

    # --------------------------------------------------------------------------
    # Logging
    # --------------------------------------------------------------------------
    log {
        output stderr
        level  INFO
    }

    # --------------------------------------------------------------------------
    # /ollama – local Ollama inference server
    # --------------------------------------------------------------------------
    handle_path {$OLLAMA_URL} {
        reverse_proxy {$OLLAMA_HOST}:{$OLLAMA_PORT} {
            header_up Host {upstream_hostport}
        }
    }

    # --------------------------------------------------------------------------
    # /llama-swap – llama.cpp model-swap proxy
    # --------------------------------------------------------------------------
    handle_path {$LLAMASWAP_URL} {
        reverse_proxy {$LLAMASWAP_HOST}:{$LLAMASWAP_PORT} {
            header_up Host {upstream_hostport}
        }
    }

    # --------------------------------------------------------------------------
    # /openwebui – Open WebUI chat front-end
    # --------------------------------------------------------------------------
    handle_path {$OPENWEBUI_URL} {
        reverse_proxy {$OPENWEBUI_HOST}:{$OPENWEBUI_PORT} {
            header_up Host {upstream_hostport}
        }
    }

    # --------------------------------------------------------------------------
    # /terminal – ttyd web terminal (PROTECTED, WebSocket-capable)
    # --------------------------------------------------------------------------
    handle_path {$TTYD_URL} {
        basicauth * {
            {$PROXY_AUTH_USER:admin} {$PROXY_AUTH_HASH}
        }
        reverse_proxy {$TTYD_HOST}:{$TTYD_PORT} {
            header_up Host {upstream_hostport}
            # Enable WebSocket proxying
            header_up Connection {http.request.header.Connection}
            header_up Upgrade   {http.request.header.Upgrade}
        }
    }

    # --------------------------------------------------------------------------
    # /code – code-server (browser VS Code) (PROTECTED, WebSocket-capable)
    # --------------------------------------------------------------------------
    handle_path {$VSCODE_URL} {
        basicauth * {
            {$PROXY_AUTH_USER:admin} {$PROXY_AUTH_HASH}
        }
        reverse_proxy {$VSCODE_HOST}:{$VSCODE_PORT} {
            header_up Host {upstream_hostport}
            header_up Connection {http.request.header.Connection}
            header_up Upgrade   {http.request.header.Upgrade}
        }
    }

    # --------------------------------------------------------------------------
    # /searxng – SearXNG local meta-search engine
    # --------------------------------------------------------------------------
    handle_path {$SEARXNG_URL} {
        reverse_proxy {$SEARXNG_HOST}:{$SEARXNG_PORT} {
            header_up Host {upstream_hostport}
        }
    }

    # --------------------------------------------------------------------------
    # /llamacpp-rpc – llama.cpp RPC frontend/aggregator
    # --------------------------------------------------------------------------
    handle_path {$LLAMACPP_RPC_URL} {
        reverse_proxy {$LLAMACPP_RPC_HOST}:{$LLAMACPP_RPC_PORT} {
            header_up Host {upstream_hostport}
        }
    }

    # --------------------------------------------------------------------------
    # /vnc – noVNC web VNC client (PROTECTED, WebSocket-capable)
    # --------------------------------------------------------------------------
    handle_path {$VNC_URL} {
        basicauth * {
            {$PROXY_AUTH_USER:admin} {$PROXY_AUTH_HASH}
        }
        reverse_proxy {$VNC_HOST}:{$VNC_PORT} {
            header_up Host {upstream_hostport}
            header_up Connection {http.request.header.Connection}
            header_up Upgrade   {http.request.header.Upgrade}
        }
    }

    # --------------------------------------------------------------------------
    # /localai – LocalAI inference server
    # --------------------------------------------------------------------------
    handle_path {$LOCALAI_URL} {
        reverse_proxy {$LOCALAI_HOST}:{$LOCALAI_PORT} {
            header_up Host {upstream_hostport}
            header_up X-Forwarded-Prefix /localai
        }
    }

    # --------------------------------------------------------------------------
    # Root: serve an HTML index with links to all services
    # --------------------------------------------------------------------------
    handle / {
        header Content-Type text/html
        respond <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Services Gateway</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 2rem; background-color: #f4f7f6; }
        h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem; }
        ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
        li { background: white; padding: 1rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); transition: transform 0.2s; }
        li:hover { transform: translateY(-3px); box-shadow: 0 4px 10px rgba(0,0,0,0.15); }
        a { text-decoration: none; color: #3498db; font-weight: bold; display: block; }
        .description { font-size: 0.9rem; color: #666; margin-top: 0.5rem; }
        .protected { font-size: 0.75rem; color: #e67e22; font-weight: normal; margin-left: 5px; text-transform: uppercase; }
    </style>
</head>
<body>
    <h1>AI Services Gateway</h1>
    <ul>
        <li>
            <a href="/ollama/">Ollama</a>
            <div class="description">Local Ollama inference server</div>
        </li>
        <li>
            <a href="/localai/">LocalAI</a>
            <div class="description">LocalAI inference server</div>
        </li>
        <li>
            <a href="/llama-swap/">Llama-swap</a>
            <div class="description">llama.cpp model-swap proxy</div>
        </li>
        <li>
            <a href="/openwebui/">Open WebUI</a>
            <div class="description">Open WebUI chat front-end</div>
        </li>
        <li>
            <a href="/terminal/">Terminal<span class="protected">(Protected)</span></a>
            <div class="description">ttyd web terminal</div>
        </li>
        <li>
            <a href="/code/">Code Server<span class="protected">(Protected)</span></a>
            <div class="description">VS Code in the browser</div>
        </li>
        <li>
            <a href="/searxng/">SearXNG</a>
            <div class="description">Local meta-search engine</div>
        </li>
        <li>
            <a href="/llamacpp-rpc/">Llama.cpp RPC</a>
            <div class="description">RPC frontend/aggregator</div>
        </li>
        <li>
            <a href="/vnc/">VNC<span class="protected">(Protected)</span></a>
            <div class="description">noVNC web client</div>
        </li>
    </ul>
</body>
</html>
HTML 200
    }

    # --------------------------------------------------------------------------
    # Default: 404 for unmatched paths
    # --------------------------------------------------------------------------
    handle {
        respond "Not found" 404
    }
}
